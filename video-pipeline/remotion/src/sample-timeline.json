  "scenes": [
    {
      "id": "hook",
      "beat": "hook",
      "visual": "title",
      "emotion": "excited",
      "text": "Mum, I made you something no shop could ever sell.",
      "start": 0.0,
      "end": 3.901
    },
    {
      "id": "roses",
      "beat": "build",
      "visual": "roses",
      "emotion": "warm",
      "text": "First, roses. Every single one is a love note.",
      "start": 3.901,
      "end": 8.129
    },
    {
      "id": "bag",
      "beat": "build",
      "visual": "bag",
      "emotion": "playful",
      "text": "A Birkin, darling. Because you are the most iconic woman I know.",
      "start": 8.129,
      "end": 12.861
    },
    {
      "id": "perfume",
      "beat": "build",
      "visual": "perfume",
      "emotion": "warm",
      "text": "And your signature scent. Soft, unforgettable. Just like you.",
      "start": 12.861,
      "end": 18.316
    },
    {
      "id": "interrupt",
      "beat": "pattern_interrupt",
      "visual": "letter",
      "emotion": "hushed",
      "text": "But the real gift isn't any of these.",
      "start": 18.316,
      "end": 21.896
    },
    {
      "id": "payoff",
      "beat": "payoff",
      "visual": "letter",
      "emotion": "tender",
      "text": "It's saying what I never say enough. You gave me strength, kindness, and a love that never ends.",
      "start": 21.896,
      "end": 30.308
    },
    {
      "id": "privilege",
      "beat": "payoff",
      "visual": "hearts",
      "emotion": "tender",
      "text": "Being your daughter is my greatest privilege.",
      "start": 30.308,
      "end": 33.657
    },
    {
      "id": "signoff",
      "beat": "loop",
      "visual": "title",
      "emotion": "excited",
      "text": "Happy Mother's Day, Mum. Forever your little girl.",
      "start": 33.657,
      "end": 38.517
    }
