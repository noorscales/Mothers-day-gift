  "scenes": [
    {
      "id": "hook",
      "beat": "hook",
      "visual": "crash",
      "emotion": "urgent",
      "text": "Most traders don't blow up from bad entries. They blow up from bad sizing.",
      "start": 0.0,
      "end": 5.519
    },
    {
      "id": "rule1",
      "beat": "build",
      "visual": "risk",
      "emotion": "confident",
      "text": "Rule one: risk one percent of your account per trade. Max.",
      "start": 5.519,
      "end": 10.485
    },
    {
      "id": "drawdown",
      "beat": "build",
      "visual": "drawdown",
      "emotion": "emphatic",
      "text": "Ten losses in a row? You still have ninety percent. At ten percent risk? About a third.",
      "start": 10.485,
      "end": 18.056
    },
    {
      "id": "rule2",
      "beat": "build",
      "visual": "stoploss",
      "emotion": "confident",
      "text": "Rule two: set your stop before you enter. Not after it hurts.",
      "start": 18.056,
      "end": 23.142
    },
    {
      "id": "rule3",
      "beat": "build",
      "visual": "rr",
      "emotion": "confident",
      "text": "Rule three: only take trades that pay at least twice the risk.",
      "start": 23.142,
      "end": 28.072
    },
    {
      "id": "interrupt",
      "beat": "pattern_interrupt",
      "visual": "winrate",
      "emotion": "hushed",
      "text": "Here's the part nobody posts.",
      "start": 28.072,
      "end": 31.019
    },
    {
      "id": "payoff",
      "beat": "payoff",
      "visual": "winrate",
      "emotion": "emphatic",
      "text": "At two to one, you can lose six trades out of ten and still profit.",
